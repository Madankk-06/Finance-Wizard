# ── Finance Wizard backend — environment template ────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database encryption ───────────────────────────────────────────────────────
# 32-byte (256-bit) key for AES-256-GCM field encryption / SQLCipher passphrase.
# Generate with:  python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DB_ENCRYPTION_KEY=REPLACE_ME_32_BYTE_BASE64_URL_SAFE_KEY

# ── Database path (relative to backend/ dir) ─────────────────────────────────
DB_PATH=recon.db

# ── Samples data directory ────────────────────────────────────────────────────
# Points at the pre-generated CSV files (settlement_report, bank_statement, ledger).
# ground_truth.csv lives here too but is NEVER loaded into match/classify logic.
SAMPLES_DIR=../public/samples

# ── FastAPI / server ─────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── CORS allowed origins (comma-separated) ───────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Optional: LLM (Phase 5/8 explanations + NL Ask) ─────────────────────────
# Leave blank to run without LLM — all phases 0-4 work offline.
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
